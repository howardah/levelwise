{
  "name": "loudcheck",
  "version": "0.2.0",
  "private": true,
  "author": {
    "name": "Adam Thomas Howard",
    "url": "https://github.com/howardah"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "bun run typecheck && bun run test && bun run typecheck:rust && bun run test:rust",
    "bump:patch": "bun ./scripts/bump-version.ts patch",
    "bump:minor": "bun ./scripts/bump-version.ts minor",
    "bump:major": "bun ./scripts/bump-version.ts major"
  },
  "dependencies": {
    "@tauri-apps/api": "^1",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "5.6.3",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.8"
  }
}
